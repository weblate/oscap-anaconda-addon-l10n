#: ../org_fedora_oscap/rule_handling.py:400
#, python-brace-format
msgid ""
"{0} must be on a separate partition or logical volume and has to be created "
"in the partitioning layout before installation can occur with a security "
"profile"
msgstr ""
"{0} harus berada pada partisi terpisah atau volume logis dan harus dibuat "
"dalam tata letak partisi sebelum instalasi dapat dilakukan dengan profil "
"keamanan"

#. template for the message
#: ../org_fedora_oscap/rule_handling.py:411
#, python-format
msgid ""
"mount option '%(mount_option)s' added for the mount point %(mount_point)s"
msgstr ""
"opsi mount '%(mount_option)s' ditambahkan untuk titik mount %(mount_point)s"

#. root password was not set
#: ../org_fedora_oscap/rule_handling.py:520
#, python-format
msgid "make sure to create password with minimal length of %d characters"
msgstr "pastikan untuk membuat kata sandi dengan panjang minimal %d karakter"

#: ../org_fedora_oscap/rule_handling.py:527
msgid "cannot check root password length (password is crypted)"
msgstr "tidak dapat memeriksa panjang kata sandi root (kata sandi dienkripsi)"

#. too short
#: ../org_fedora_oscap/rule_handling.py:533
#, python-format
msgid ""
"root password is too short, a longer one with at least %d characters is "
"required"
msgstr ""
"kata sandi root terlalu pendek, diperlukan kata sandi yang lebih panjang "
"dengan setidaknya %d karakter"

#: ../org_fedora_oscap/rule_handling.py:637
#: ../org_fedora_oscap/rule_handling.py:652
#, python-format
msgid "package '%s' has been added to the list of to be installed packages"
msgstr "paket '%s' telah ditambahkan ke daftar paket yang akan diinstal"

#: ../org_fedora_oscap/rule_handling.py:661
#: ../org_fedora_oscap/rule_handling.py:676
#, python-format
msgid "package '%s' has been added to the list of excluded packages"
msgstr "paket '%s' telah ditambahkan ke daftar paket yang dikecualikan"

#: ../org_fedora_oscap/rule_handling.py:777
msgid "Kdump will be disabled on startup"
msgstr "Kdump akan dinonaktifkan saat startup"

#: ../org_fedora_oscap/rule_handling.py:779
msgid "Kdump will be enabled on startup"
msgstr "Kdump akan diaktifkan saat startup"

#: ../org_fedora_oscap/rule_handling.py:932
msgid "Firewall will be disabled on startup"
msgstr "Firewall akan dinonaktifkan saat startup"

#: ../org_fedora_oscap/rule_handling.py:939
msgid "Firewall will be enabled on startup"
msgstr "Firewall akan diaktifkan saat startup"

#: ../org_fedora_oscap/rule_handling.py:947
#: ../org_fedora_oscap/rule_handling.py:986
#, python-format
msgid ""
"service '%s' has been added to the list of services to be added to the "
"firewall"
msgstr ""
"layanan '%s' telah ditambahkan ke daftar layanan yang akan ditambahkan ke "
"firewall"

#: ../org_fedora_oscap/rule_handling.py:954
#: ../org_fedora_oscap/rule_handling.py:999
#, python-format
msgid ""
"port '%s' has been added to the list of ports to be added to the firewall"
msgstr ""
"port '%s' telah ditambahkan ke daftar port yang akan ditambahkan ke firewall"

#: ../org_fedora_oscap/rule_handling.py:961
#: ../org_fedora_oscap/rule_handling.py:1012
#, python-format
msgid ""
"trust '%s' has been added to the list of trusts to be added to the firewall"
msgstr ""
"trust '%s' telah ditambahkan ke daftar trust yang akan ditambahkan ke "
"firewall"

#: ../org_fedora_oscap/rule_handling.py:1024
#: ../org_fedora_oscap/rule_handling.py:1039
#, python-format
msgid ""
"service '%s' has been added to the list of services to be removed from the "
"firewall"
msgstr ""
"layanan '%s' telah ditambahkan ke daftar layanan yang akan dihapus dari "
"firewall"

#: ../org_fedora_oscap/ks/oscap.py:418
#, python-format
msgid ""
"There was an error fetching and loading the security content:\n"
"%s\n"
"The installation should be aborted. Do you wish to continue anyway?"
msgstr ""
"Terjadi kesalahan saat mengambil dan memuat konten keamanan:\n"
"%s\n"
"Instalasi harus dibatalkan. Apakah Anda ingin melanjutkan?"

#: ../org_fedora_oscap/ks/oscap.py:447
msgid ""
"The integrity check of the security content failed.\n"
"The installation should be aborted. Do you wish to continue anyway?"
msgstr ""
"Pemeriksaan integritas konten keamanan gagal.\n"
"Instalasi harus dibatalkan. Apakah Anda ingin melanjutkan?"

#. title of the spoke (will be displayed on the hub)
#: ../org_fedora_oscap/gui/spokes/oscap.py:198
msgid "_Security Policy"
msgstr "_Kebijakan Keamanan"

#. the first status provided
#: ../org_fedora_oscap/gui/spokes/oscap.py:223
msgid "Not ready"
msgstr "Belum siap"

#: ../org_fedora_oscap/gui/spokes/oscap.py:371
msgid "Fetching content data"
msgstr "Mengambil data konten"

#: ../org_fedora_oscap/gui/spokes/oscap.py:638
#: ../org_fedora_oscap/gui/spokes/oscap.py:1053
msgid "No profile selected"
msgstr "Tidak ada profil yang dipilih"

#: ../org_fedora_oscap/gui/spokes/oscap.py:643
msgid "No rules for the pre-installation phase"
msgstr "Tidak ada aturan untuk fase pra-instalasi"

#: ../org_fedora_oscap/gui/spokes/oscap.py:795
msgid "Invalid content provided. Enter a different URL, please."
msgstr "Konten yang diberikan tidak valid. Masukkan URL yang berbeda."

#: ../org_fedora_oscap/gui/spokes/oscap.py:803
msgid "Invalid or unsupported content URL, please enter a different one."
msgstr ""
"URL konten tidak valid atau tidak didukung, harap masukkan yang berbeda."

#: ../org_fedora_oscap/gui/spokes/oscap.py:811
msgid "Failed to fetch content. Enter a different URL, please."
msgstr "Gagal mengambil konten. Masukkan URL yang berbeda."

#: ../org_fedora_oscap/gui/spokes/oscap.py:819
msgid ""
"Network error encountered when fetching data. Please check that network is "
"setup and working."
msgstr ""
"Kesalahan jaringan ditemui saat mengambil data. Harap periksa bahwa jaringan "
"sudah diatur dan berfungsi."

#: ../org_fedora_oscap/gui/spokes/oscap.py:828
msgid "The integrity check of the content failed. Cannot use the content."
msgstr "Pemeriksaan integritas konten gagal. Tidak dapat menggunakan konten."

#: ../org_fedora_oscap/gui/spokes/oscap.py:836
#, python-format
msgid "Failed to extract content (%s). Enter a different URL, please."
msgstr "Gagal mengekstrak konten (%s). Masukkan URL yang berbeda."

#: ../org_fedora_oscap/gui/spokes/oscap.py:854
#, python-format
msgid ""
"Profile with ID '%s' not defined in the content. Select a different profile, "
"please"
msgstr ""
"Profil dengan ID '%s' tidak didefinisikan dalam konten. Pilih profil yang "
"berbeda"

#: ../org_fedora_oscap/gui/spokes/oscap.py:870
msgid "Not applying security policy"
msgstr "Tidak menerapkan kebijakan keamanan"

#. TRANSLATORS: the other choice if SCAP Security Guide is also
#. available
#: ../org_fedora_oscap/gui/spokes/oscap.py:901
msgid " or enter data stream content or archive URL below:"
msgstr " atau masukkan konten data stream atau URL arsip di bawah:"

#: ../org_fedora_oscap/gui/spokes/oscap.py:905
msgid ""
"No content found. Please enter data stream content or archive URL below:"
msgstr ""
"Tidak ada konten yang ditemukan. Harap masukkan konten data stream atau URL "
"arsip di bawah:"

#: ../org_fedora_oscap/gui/spokes/oscap.py:1043
msgid "Error fetching and loading content"
msgstr "Kesalahan mengambil dan memuat konten"

#: ../org_fedora_oscap/gui/spokes/oscap.py:1050
msgid "No content found"
msgstr "Tidak ada konten yang ditemukan"

#: ../org_fedora_oscap/gui/spokes/oscap.py:1061
msgid "Misconfiguration detected"
msgstr "Miskonfigurasi terdeteksi"

#: ../org_fedora_oscap/gui/spokes/oscap.py:1067
msgid "Warnings appeared"
msgstr "Peringatan muncul"

#: ../org_fedora_oscap/gui/spokes/oscap.py:1069
msgid "Everything okay"
msgstr "Semuanya baik"

#: ../org_fedora_oscap/gui/spokes/oscap.py:1145
msgid "Invalid or unsupported URL"
msgstr "URL tidak valid atau tidak didukung"

#: ../org_fedora_oscap/gui/spokes/oscap.py:1151 tmp/oscap.glade.h:14
msgid "Fetching content..."
msgstr "Mengambil konten..."

