msgstr "Ubah konten"

#: tmp/oscap.glade.h:3
msgid "Apply security policy:"
msgstr "Terapkan kebijakan keamanan:"

#: tmp/oscap.glade.h:4
msgid "Data stream:"
msgstr "Data stream:"

