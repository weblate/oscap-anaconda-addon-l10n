msgid "SECURITY POLICY"
msgstr "უსაფრთხოების პოლიტიკა"

#: tmp/oscap.glade.h:2
msgid "_Change content"
msgstr "_შემცველობის შეცვლა"

#: tmp/oscap.glade.h:3
