msgstr "უსაფრთხოებით პოლიტიკის გადატარება:"

#: tmp/oscap.glade.h:4
msgid "Data stream:"
msgstr "მონაცემების ნაკადი:"

#: tmp/oscap.glade.h:5
msgid "Checklist:"
msgstr "საკონტროლო სია:"

#: tmp/oscap.glade.h:6
msgid "Choose profile below:"
msgstr "აირჩიეთ პროფილი ქვემოთ:"

#: tmp/oscap.glade.h:7
msgid "Profile"
msgstr "პროფილი"

#: tmp/oscap.glade.h:8
msgid "Selected"
msgstr "არჩეულია"

#: tmp/oscap.glade.h:9
msgid "_Select profile"
msgstr "აირჩიეთ პროფილი"

#: tmp/oscap.glade.h:10
msgid "Changes that were done or need to be done:"
msgstr "ცვლილებები, რომლებიც მოხდა, ან საჭიროა, მოხდეს:"

#: tmp/oscap.glade.h:11
msgid "_Use SCAP Security Guide"
msgstr "SCAP-ის უსაფრთხოების სახელმძღვანელოს _გამოყენება"

#: tmp/oscap.glade.h:12
msgid "_Fetch"
msgstr "_გამოთხოვა"
