#: ../org_fedora_oscap/common.py:358
#, python-brace-format
msgid "Error extracting archive as a zipfile: {exc}"
msgstr "არქივის zip ფაილად გაშლის შეცდომა: {exc}"

#: ../org_fedora_oscap/content_discovery.py:189
#, python-brace-format
msgid ""
"Integrity check of the content failed - {hash_obj.name} hash didn't match"
msgstr ""
"შემცველობის მთლიანობის შემოწმება ჩავარდა - {hash_obj.name} ჰეში არ ემთხვევა"

#: ../org_fedora_oscap/data_fetch.py:117
msgid "Network connection needed to fetch data."
msgstr "მონაცემების გამოსათხოვად აუცილებელია ქსელური კავშირი."

#: ../org_fedora_oscap/data_fetch.py:262
#, python-brace-format
msgid ""
"Failed to fetch data - the request returned HTTP error code {return_code}"
msgstr ""
"მონაცემების გამოთხოვის შეცდომა - მოთხოვნამ დააბრუნა HTTP-ის შეცდომის კოდი "
"{return_code}"

#: ../org_fedora_oscap/rule_handling.py:441
#, python-brace-format
msgid ""
"{0} must be on a separate partition or logical volume and has to be created "
"in the partitioning layout before installation can occur with a security "
"profile"
msgstr ""
"{0} ცალკე დანაყოფზე ან ლოგიკურ ტომზე უნდა იყოს და დანაყოფებში მანამდე უნდა "
"შეიქმნას, სანამ უსაფრთხოების პროფილით დაყენება განხორციელდება"

#. template for the message
#: ../org_fedora_oscap/rule_handling.py:452
#, python-format
msgid ""
"mount option '%(mount_option)s' added for the mount point %(mount_point)s"
msgstr ""
"მიმაგრების პარამეტრი '%(mount_option)s' დაემატა მიმაგრების წერტილს %"
"(mount_point)s"

#. root password was not set
#: ../org_fedora_oscap/rule_handling.py:560
#, python-format
msgid "make sure to create password with minimal length of %d characters"
msgstr "დარწმუნდით, რომ შექმნათ პაროლი, რომელიც, მინიმუმ %d სიმბოლოს შეიცავს"

#: ../org_fedora_oscap/rule_handling.py:567
msgid "cannot check root password length (password is crypted)"
msgstr "root-ის პაროლის შემოწმება შეუძლებელია (პაროლი დაშიფრულია)"

#. too short
#: ../org_fedora_oscap/rule_handling.py:573
#, python-format
msgid ""
"root password is too short, a longer one with at least %d characters is "
"required"
msgstr ""
"root-ის პაროლი მეტისმეტად მოკლეა. საჭიროა უფრო გრძელი, სულ ცოტა %d სიმბოლოს "
"შემცველი პაროლი"

#: ../org_fedora_oscap/rule_handling.py:712
#: ../org_fedora_oscap/rule_handling.py:727
#, python-format
msgid "package '%s' has been added to the list of to be installed packages"
msgstr "პაკეტი '%s' დაემატა დასაყენებელი პაკეტების სიას"

#: ../org_fedora_oscap/rule_handling.py:737
#, python-brace-format
msgid ""
"package '{package}' has been added to the list of excluded packages, but it "
"can't be removed from the current software selection without breaking the "
"installation."
msgstr ""
"პაკეტი '{package}' დაემატა ამოსაღები პაკეტების სიას, მაგრამ ის მიმდინარე "
"პროგრამების არჩევნიდან ამოღებული ვერ იქნება დაყენების გაფუჭების გარეშე."

#: ../org_fedora_oscap/rule_handling.py:744
#: ../org_fedora_oscap/rule_handling.py:759
#, python-format
msgid "package '%s' has been added to the list of excluded packages"
msgstr "პაკეტი '%s' დაემატა ამოსაღები პაკეტების სიას"

#: ../org_fedora_oscap/rule_handling.py:866
msgid "Kdump will be disabled on startup"
msgstr "Kdump ჩატვირთვის დროს გათიშული იქნება"

#: ../org_fedora_oscap/rule_handling.py:868
msgid "Kdump will be enabled on startup"
msgstr "Kdump ჩატვირთვისას ჩართული იქნება"

#: ../org_fedora_oscap/rule_handling.py:1026
msgid "Firewall will be disabled on startup"
msgstr "ბრანდმაუერი ჩატვირთვისას გათიშული იქნება"

#: ../org_fedora_oscap/rule_handling.py:1033
msgid "Firewall will be enabled on startup"
msgstr "ბრანდმაუერი ჩატვირთვისას ჩართული იქნება"

#: ../org_fedora_oscap/rule_handling.py:1041
#: ../org_fedora_oscap/rule_handling.py:1080
#, python-format
msgid ""
"service '%s' has been added to the list of services to be added to the "
"firewall"
msgstr "სერვისი '%s' დაემატა სერვისების სიას, რომელიც ბრანდმაუერში ჩაემატება"

#: ../org_fedora_oscap/rule_handling.py:1048
#: ../org_fedora_oscap/rule_handling.py:1093
#, python-format
msgid ""
"port '%s' has been added to the list of ports to be added to the firewall"
msgstr "პორტი '%s' დაემატა პორტების სიას, რომელიც ბრანდმაუერში ჩაემატება"

#: ../org_fedora_oscap/rule_handling.py:1055
#: ../org_fedora_oscap/rule_handling.py:1106
#, python-format
msgid ""
"trust '%s' has been added to the list of trusts to be added to the firewall"
msgstr "ნდობა '%s' დაემატა ნდობების სიას, რომელიც ბრანდმაუერში ჩაემატება"

#: ../org_fedora_oscap/rule_handling.py:1118
#: ../org_fedora_oscap/rule_handling.py:1133
#, python-format
msgid ""
"service '%s' has been added to the list of services to be removed from the "
"firewall"
msgstr "სერვისი '%s' დაემატა სერვისების სიას, რომელიც ბრანდმაუერიდან დაემატება"

#: ../org_fedora_oscap/service/installation.py:41
msgid "The integrity check of the security content failed."
msgstr "უსაფრთხოების შემცველობის მთლიანობის შემოწმება ჩავარდა."

#: ../org_fedora_oscap/service/installation.py:46
msgid "There was an error fetching and loading the security content:\n"
msgstr "უსაფრთხოების შემცველობის გამოთხოვისა და ჩატვირთვის შეცდომა:\n"

#: ../org_fedora_oscap/service/installation.py:51
#: ../org_fedora_oscap/gui/spokes/oscap.py:793
msgid "There was an unexpected problem with the supplied content."
msgstr "მოულოდნელი პრობლემა გადმოცემულ შემცველობასთან."

#: ../org_fedora_oscap/service/installation.py:56
msgid "The installation should be aborted."
msgstr "დაყენება უნდა შეწვეტილიყო."

#: ../org_fedora_oscap/service/installation.py:148
msgid "Wrong configuration detected!"
msgstr "აღმოჩენილია არასწორი კონფიგურაცია!"

#: ../org_fedora_oscap/service/oscap.py:121
msgid "You have used more than one oscap addon sections in the kickstart. "
msgstr "kickstart-ში ერთზე მეტ oscap-ის დამატების სექციას იყენებთ. "

#: ../org_fedora_oscap/service/oscap.py:135
#, python-brace-format
msgid ""
"You have configured the oscap addon using '{used_section_header}' section. "
msgstr "თქვენ მოირგეთ oscap-ის დამატება სექციით '{used_section_header}'. "

#. title of the spoke (will be displayed on the hub)
#: ../org_fedora_oscap/gui/spokes/oscap.py:201
msgid "_Security Profile"
msgstr "უ_საფრთხოების პროფილი"

#. the first status provided
#: ../org_fedora_oscap/gui/spokes/oscap.py:228
msgid "Not ready"
msgstr "მზად არაა"

#: ../org_fedora_oscap/gui/spokes/oscap.py:393
msgid "Fetching content data"
msgstr "შემცველობის მონაცემების გამოთხოვა"

#: ../org_fedora_oscap/gui/spokes/oscap.py:431
msgid "Fetch complete, analyzing data."
msgstr "გამოთხოვა დასრულდა. მიმდინარეობს მონაცემების ანალიზი."

#: ../org_fedora_oscap/gui/spokes/oscap.py:643
#: ../org_fedora_oscap/gui/spokes/oscap.py:1072
msgid "No profile selected"
msgstr "პროფილი არჩეული არაა"

#: ../org_fedora_oscap/gui/spokes/oscap.py:648
msgid "No rules for the pre-installation phase"
msgstr "დაყენებისწინა ფაზის წესების გარეშე"

#: ../org_fedora_oscap/gui/spokes/oscap.py:801
msgid "Invalid content provided. Enter a different URL, please."
msgstr "მიწოდებული შემცველობა არასწორია. შეიყვანეთ სხვა URL, გეთაყვა."

#: ../org_fedora_oscap/gui/spokes/oscap.py:809
msgid "Invalid or unsupported content URL, please enter a different one."
msgstr "არასწორი ან მხარდაუჭერელი შემცველობის ბმული. შეიყვანეთ სხვა."

#: ../org_fedora_oscap/gui/spokes/oscap.py:817
msgid "Failed to fetch content. Enter a different URL, please."
msgstr "შემცველობის გამოთხოვა ჩავარდა. შეიყვანეთ სხვა ბმული."

#: ../org_fedora_oscap/gui/spokes/oscap.py:825
msgid ""
"Network error encountered when fetching data. Please check that network is "
"setup and working."
msgstr ""
"ქსელის შეცდომა მონაცემების გამოთხოვისას. შეამოწმეთ, რომ ქსელი მორგებულია და "
"მუშაობს."

#: ../org_fedora_oscap/gui/spokes/oscap.py:834
msgid "The integrity check of the content failed. Cannot use the content."
msgstr "შემცველობის მთლიანობის შემოწმება ჩავარდა. შემცველობას ვერ გამოვიყენებ."

#: ../org_fedora_oscap/gui/spokes/oscap.py:842
#, python-format
msgid "Failed to extract content (%s). Enter a different URL, please."
msgstr "შემცველობის (%s) გაშლა ჩავარდა. სხვა ბმული შეიყვანეთ, გეთაყვა."

#: ../org_fedora_oscap/gui/spokes/oscap.py:860
#, python-format
msgid ""
"Profile with ID '%s' not defined in the content. Select a different profile, "
"please"
msgstr ""
"პროფილი ID-ით '%s' შემცველობაში აღწერილი არაა. სხვა პროფილი აირჩიეთ, გეთაყვა"

#: ../org_fedora_oscap/gui/spokes/oscap.py:879
msgid "Not applying security profile"
msgstr "უსაფრთხოების პროფილი გადატარებული არ იქნება"

#. TRANSLATORS: the other choice if SCAP Security Guide is also
#. available
#: ../org_fedora_oscap/gui/spokes/oscap.py:921
msgid " or enter data stream content or archive URL below:"
msgstr " ან შეიყვანეთ მონაცემების ნაკადის შემცველობა ან არქივის ბმული ქვემოთ:"

#: ../org_fedora_oscap/gui/spokes/oscap.py:925 tmp/oscap.glade.h:12
msgid ""
"No content found. Please enter data stream content or archive URL below:"
msgstr ""
"შემცველობა ვერ ვიპოვე. შეიყვანეთ მონაცემების ნაკადის შემცველობა ან არქივის "
"ბმული ქვემოთ:"

#: ../org_fedora_oscap/gui/spokes/oscap.py:1062
msgid "Error fetching and loading content"
msgstr "შემცველობის გამოთხოვისა და ჩატვირთვის შეცდომა"

#: ../org_fedora_oscap/gui/spokes/oscap.py:1069
msgid "No content found"
msgstr "შემცველობა აღმოჩენილი არაა"

#: ../org_fedora_oscap/gui/spokes/oscap.py:1080
msgid "Misconfiguration detected"
msgstr "აღმოჩენილია კონფიგურაციის შეცდომა"

#: ../org_fedora_oscap/gui/spokes/oscap.py:1086
msgid "Warnings appeared"
msgstr "გამოჩნდა გაფრთხილებები"

#: ../org_fedora_oscap/gui/spokes/oscap.py:1088
msgid "Everything okay"
msgstr "ყველაფერი კარგადაა"

#: ../org_fedora_oscap/gui/spokes/oscap.py:1170
msgid "Invalid or unsupported URL"
msgstr "არასწორი ან მხარდაუჭერელი URL"

